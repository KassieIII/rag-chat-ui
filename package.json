{
  "name": "rag-chat-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js 15 streaming chat UI for the rag-docs RAG API. SSE token-by-token answers, live citations, dark mode.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "16.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.9.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.14.0",
    "eslint-config-next": "16.2.4",
    "happy-dom": "15.10.1",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
