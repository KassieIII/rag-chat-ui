# Direct mode: the browser hits the RAG API directly.
# Set this for production (e.g. Vercel) where the API has CORS configured.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Proxy mode: leave NEXT_PUBLIC_API_URL empty and set this to make
# Next.js proxy /api/* to the backend. Useful in dev when the API
# doesn't allow cross-origin requests.
RAG_API_PROXY_TARGET=
